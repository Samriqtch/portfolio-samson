---
// Page d'accueil : deux univers côte à côte.
import Base from '../layouts/Base.astro';
import { background, backgroundStyle } from '../lib/images';
import textes from '../data/textes.json';

const bgDev = await background('bg-dev-wall.jpg');
const bgDesign = await background('bg-design-wall.jpg');
const { dev, design } = textes.accueil;
---

<Base
  title="Samson Klougan · Développeur web, graphiste et communicant digital"
  description="Portfolio de Samson Klougan (Dream Conception), à Lomé : développement web, graphisme, vidéo et community management."
  theme="home"
>
  <main class="split">
    <a class="half half-dev" href="/developpeur/" style={backgroundStyle(bgDev)}>
      <h1 class="half-title">Je<br />code.</h1>
      <p>{dev.texte}</p>
      <span class="enter">{dev.lien}</span>
    </a>
    <a class="half half-design" href="/graphiste/" style={backgroundStyle(bgDesign)}>
      <h2 class="half-title">Je<br />crée.</h2>
      <p>{design.texte}</p>
      <span class="enter">{design.lien}</span>
    </a>
  </main>

  <!-- Les anciens liens #dev et #graphiste redirigent vers les nouvelles pages -->
  <script is:inline>
    if (location.hash === '#dev') location.replace('/developpeur/');
    if (location.hash === '#graphiste') location.replace('/graphiste/');
  </script>
</Base>

<style>
  .split {
    display: flex;
    min-height: 100vh;
    min-height: 100svh;
  }
  .half {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.1rem;
    padding: 7rem var(--gutter-r) clamp(3rem, 8vh, 6rem) var(--gutter-l);
    text-decoration: none;
    background-size: cover;
    background-position: center;
    transition: flex 0.7s var(--ease), background-position 1.2s ease;
  }
  .half-dev {
    color: var(--craie);
    background-image:
      linear-gradient(0deg, rgba(20, 25, 56, 0.97) 0%, rgba(20, 25, 56, 0.84) 42%, rgba(20, 25, 56, 0.5) 100%),
      var(--bg-lg);
    background-color: var(--indigo);
  }
  .half-design {
    color: var(--indigo);
    background-image:
      linear-gradient(0deg, rgba(242, 185, 37, 0.98) 0%, rgba(242, 185, 37, 0.88) 40%, rgba(242, 185, 37, 0.42) 100%),
      var(--bg-lg);
    background-color: var(--safran);
  }
  .half-title {
    font-size: clamp(3.5rem, 11vw, 10.5rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    font-weight: 900;
  }
  .half-dev .half-title {
    font-family: var(--mono);
    font-weight: 600;
    letter-spacing: -0.06em;
  }
  .half-design .half-title {
    font-stretch: 125%;
    font-weight: 800;
    transition: font-stretch 0.7s var(--ease);
  }
  .half p {
    max-width: 34ch;
    font-size: 1.05rem;
    opacity: 0.9;
  }
  .enter {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
  }
  .enter::before {
    content: '';
    width: 2.4rem;
    height: 2px;
    background: currentColor;
    transition: width 0.4s;
  }
  .half:hover .enter::before,
  .half:focus-visible .enter::before {
    width: 4rem;
  }
  @media (hover: hover) and (min-width: 761px) {
    .split:hover .half {
      flex: 0.75;
    }
    .split .half:hover {
      flex: 1.6;
      background-position: center 40%;
    }
    .half-design:hover .half-title {
      font-stretch: 100%;
    }
  }

  @media (max-width: 760px) {
    .split {
      flex-direction: column;
    }
    .half {
      justify-content: center;
      padding-top: 5.5rem;
      padding-bottom: 2.5rem;
    }
    .half-dev,
    .half-design {
      background-image:
        linear-gradient(0deg, var(--overlay-strong, rgba(20, 25, 56, 0.95)) 0%, var(--overlay-soft, rgba(20, 25, 56, 0.7)) 100%),
        var(--bg-sm);
    }
    .half-design {
      --overlay-strong: rgba(242, 185, 37, 0.96);
      --overlay-soft: rgba(242, 185, 37, 0.62);
      padding-top: 2.5rem;
    }
    .half-title {
      font-size: clamp(3.2rem, 17vw, 6rem);
    }
    .half p {
      font-size: 0.95rem;
    }
  }
</style>
