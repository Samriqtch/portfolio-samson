---
// Page « Graphiste & communicant digital »
import Base from '../layouts/Base.astro';
import FondAnime from '../components/design/FondAnime.astro';
import DesignHero from '../components/design/DesignHero.astro';
import Bandeau from '../components/design/Bandeau.astro';
import Chiffres from '../components/design/Chiffres.astro';
import Metiers from '../components/design/Metiers.astro';
import Affiches from '../components/design/Affiches.astro';
import Clients from '../components/design/Clients.astro';
import PagesGerees from '../components/design/PagesGerees.astro';
import Evenements from '../components/design/Evenements.astro';
import Videos from '../components/design/Videos.astro';
import Cases from '../components/shared/Cases.astro';
import Timeline from '../components/shared/Timeline.astro';
import About from '../components/shared/About.astro';
import Contact from '../components/shared/Contact.astro';
import Lightbox from '../components/shared/Lightbox.astro';
import { background, lazyBackground } from '../lib/images';
import textes from '../data/textes.json';
import identites from '../data/identites.json';
import communication from '../data/communication.json';
import parcours from '../data/parcours-graphiste.json';
import contact from '../data/contact.json';

const { apropos, contact: bloc } = textes.design;
const bgIdentites = await background('bg-identites.jpg', 1800, 900);
---

<Base
  title="Samson Klougan · Graphiste, community manager et vidéaste à Lomé"
  description="Affiches, identités visuelles, vidéos et community management : les réalisations de Samson Klougan (Dream Conception), à Lomé."
  theme="design"
>
  <FondAnime />
  <main>
    <DesignHero />
    <Bandeau />
    <Chiffres />
    <Metiers />
    <Affiches />

    <section class="section identites" id="identites" {...lazyBackground(bgIdentites)}>
      <div class="wrap">
        <h2 class="sec-title">Identités visuelles</h2>
        <p class="lead intro">Logo, couleurs, typographies et déclinaisons sur tous les supports. Cliquez sur un projet pour parcourir sa présentation.</p>
        <Cases id="identites" items={identites as any} />
      </div>
    </section>

    <Clients />
    <PagesGerees />
    <Evenements />
    <Videos />

    <section class="section" id="communication">
      <div class="wrap">
        <h2 class="sec-title">Projets de communication</h2>
        <Cases id="communication" items={communication as any} />
      </div>
    </section>

    <section class="section parcours" id="parcours">
      <div class="wrap">
        <h2 class="sec-title">Mon parcours</h2>
        <Timeline experiences={parcours.experiences} formation={parcours.formation} outils={parcours.outils} />
      </div>
    </section>

    <About photo={apropos.photo} alt={apropos.alt} intro={apropos.intro} texte={apropos.texte} faits={apropos.faits} />
    <Contact
      titre={bloc.titre}
      texte={bloc.texte}
      lien={{ label: 'Behance', url: contact.behance, icone: 'behance' }}
      passerelle={{ titre: bloc.passerelle.titre, lien: bloc.passerelle.lien, url: '/developpeur/' }}
      vitrine={{ type: 'affiches', images: ['g-schic-ouverture.jpg', 'g-clubmalt-flyer.jpg', 'g-cigibm-affiche.jpg'] }}
    />
  </main>
  <Lightbox />
</Base>

<style>
  .intro {
    margin-top: -1.5rem;
    margin-bottom: 2.5rem;
  }
  /* Bandeau de planches qui s'efface en haut de la section identités */
  .identites {
    background-image:
      linear-gradient(180deg, rgba(242, 185, 37, 0.35) 0%, rgba(242, 185, 37, 0.85) 22%, var(--safran) 34%),
      var(--bg-lg);
    background-repeat: no-repeat, repeat-x;
    background-position: 0 0, center top;
    background-size: auto, auto 52%;
  }
  /* Motif de points derrière le parcours */
  .parcours {
    isolation: isolate;
  }
  .parcours::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--safran);
    background-image: radial-gradient(rgba(20, 25, 56, 0.16) 1.6px, transparent 1.8px);
    background-size: 22px 22px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 10%, #000 90%, transparent);
  }
  @media (max-width: 860px) {
    .identites {
      background-image:
        linear-gradient(180deg, rgba(242, 185, 37, 0.72) 0%, rgba(242, 185, 37, 0.92) 40%, var(--safran) 60%),
        var(--bg-sm);
      background-size: auto, auto 260px;
    }
  }
</style>
