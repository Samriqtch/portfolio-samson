---
// Haut de la page développeur, sur un mur de captures de sites.
import { background, backgroundStyle } from '../../lib/images';
import textes from '../../data/textes.json';

const bg = await background('bg-dev-wall.jpg');
const { intro, services } = textes.dev;
---

<section class="hero" style={backgroundStyle(bg)}>
  <div class="wrap content">
    <h1>Samson<br />Klougan<span class="caret" aria-hidden="true"></span></h1>
    <div class="row">
      <p class="lead">{intro}</p>
      <pre class="term" aria-label="Ce que je propose"><span class="c">// disponible pour des missions freelance</span>
<span class="k">const</span> services = [
{services.map((s) => <>  <span class="s">"{s}"</span>,{'\n'}</>)}];</pre>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: min(100svh, 920px);
    display: grid;
    align-items: end;
    padding-block: 7rem clamp(3rem, 7vw, 5rem);
    background-image:
      linear-gradient(180deg, transparent 70%, var(--indigo) 100%),
      linear-gradient(90deg, var(--indigo) 0%, rgba(20, 25, 56, 0.88) 38%, rgba(20, 25, 56, 0.52) 100%),
      var(--bg-lg);
    background-size: cover;
    background-position: center;
  }
  h1 {
    font-family: var(--mono);
    font-weight: 600;
    font-size: clamp(2.6rem, 9vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }
  .caret {
    display: inline-block;
    width: 0.5em;
    height: 0.85em;
    margin-left: 0.08em;
    vertical-align: -0.08em;
    background: var(--safran);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .row {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .term {
    min-width: 0;
    overflow-x: auto;
    padding: 1.25rem 1.4rem;
    border-radius: 14px;
    border: 1px solid var(--indigo-3);
    background: rgba(31, 38, 84, 0.92);
    font-family: var(--mono);
    font-size: 0.85rem;
    line-height: 1.8;
  }
  .k {
    color: var(--ciel);
  }
  .s {
    color: var(--safran-2);
  }
  .c {
    opacity: 0.5;
  }
  @media (max-width: 860px) {
    .hero {
      min-height: auto;
      padding-top: 6.5rem;
      background-image: linear-gradient(180deg, rgba(20, 25, 56, 0.7) 0%, var(--indigo) 85%), var(--bg-sm);
    }
    .row {
      grid-template-columns: 1fr;
    }
    .term {
      font-size: 0.8rem;
    }
  }
</style>
