---
// Parcours : expériences et formation en frise, plus une liste d'outils facultative.
import Icon from '../Icon.astro';

interface Entry {
  date: string;
  titre: string;
  lieu: string;
  description?: string | null;
  enCours?: boolean;
  technos?: string[];
}
interface Props {
  experiences: Entry[];
  formation: Entry[];
  outils?: string[];
}
const { experiences, formation, outils } = Astro.props;
const columns = [
  { titre: 'Expériences', icone: 'briefcase-business', items: experiences },
  { titre: 'Formation', icone: 'graduation-cap', items: formation },
];
---

<div class="cols">
  {
    columns.map((col, i) => (
      <div class="col">
        <h3 class="head">
          <Icon name={col.icone} />
          {col.titre}
        </h3>
        <ol class="timeline">
          {col.items.map((e) => (
            <li>
              <span class="date">{e.date}</span>
              <h4>
                {e.titre}
                {e.enCours && <span class="now">En cours</span>}
              </h4>
              <span class="place">{e.lieu}</span>
              {e.description && <p>{e.description}</p>}
              {e.technos && e.technos.length > 0 && (
                <ul class="tags">
                  {e.technos.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
        {i === 1 && outils && (
          <>
            <h3 class="head head-tools">
              <Icon name="wrench" />
              Mes outils
            </h3>
            <ul class="chips">
              {outils.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          </>
        )}
      </div>
    ))
  }
</div>

<style>
  .cols {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }
  .col {
    min-width: 0;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 800;
    font-stretch: 108%;
    letter-spacing: -0.02em;
    margin-bottom: 1.6rem;
  }
  .head :global(.icon) {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--accent);
  }
  :global(.theme-design) .head :global(.icon) {
    color: var(--indigo);
  }
  .head-tools {
    margin-top: 2.8rem;
  }
  .timeline {
    list-style: none;
    padding: 0;
    border-left: 2px solid var(--line);
  }
  .timeline > li {
    position: relative;
    display: grid;
    gap: 0.3rem;
    padding: 0 0 2rem 1.7rem;
  }
  .timeline > li:last-child {
    padding-bottom: 0;
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -8px;
    top: 0.3rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }
  .date {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--date);
  }
  h4 {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .now {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-fg);
  }
  .place {
    font-weight: 600;
    font-size: 0.95rem;
    opacity: 0.85;
  }
  p {
    font-size: 0.95rem;
    max-width: 54ch;
    opacity: 0.85;
  }
  .tags {
    margin-top: 0.4rem;
  }
  .chips {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chips li {
    border: 1.5px solid currentColor;
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
