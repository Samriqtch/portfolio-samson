---
// Section « À propos » : photo, présentation et trois repères.
import { Image } from 'astro:assets';
import { img } from '../../lib/images';

interface Props {
  photo: string;
  alt: string;
  intro: string;
  texte: string;
  faits: { titre: string; texte: string }[];
}
const { photo, alt, intro, texte, faits } = Astro.props;
---

<section class="section">
  <div class="wrap about">
    <div class="portrait">
      <Image src={img(photo)} alt={alt} widths={[420, 700]} sizes="(max-width: 860px) 90vw, 40vw" loading="lazy" />
    </div>
    <div class="text">
      <h2 class="sec-title">À propos</h2>
      <p class="lead">{intro}</p>
      <p>{texte}</p>
      <div class="facts">
        {
          faits.map((f) => (
            <div>
              <strong>{f.titre}</strong>
              <span>{f.texte}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .portrait {
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    background: var(--soft);
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  .text .sec-title {
    margin-bottom: 0.5rem;
  }
  .text > p:not(.lead) {
    max-width: 58ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .facts strong {
    display: block;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-stretch: 110%;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .facts span {
    font-size: 0.9rem;
    opacity: 0.8;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    .portrait {
      aspect-ratio: 16 / 11;
    }
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
