---
// Bloc de contact en bas de chaque univers, avec une vitrine de réalisations à droite.
import Icon from '../Icon.astro';
import contact from '../../data/contact.json';
import { Image } from 'astro:assets';
import { img } from '../../lib/images';

interface Props {
  titre: string;
  texte: string;
  /** Troisième bouton : GitHub côté dev, Behance côté graphiste */
  lien: { label: string; url: string; icone: string };
  /** Lien vers l'autre univers */
  passerelle: { titre: string; lien: string; url: string };
  /**
   * Vitrine à droite : 3 images de src/assets/images.
   * « affiches » = affiches en éventail (la 1re au centre), « ecrans » = captures de sites (la 1re en grand).
   */
  vitrine: { type: 'affiches' | 'ecrans'; images: [string, string, string] };
}
const { titre, texte, lien, passerelle, vitrine } = Astro.props;
const reseaux = [
  { label: 'LinkedIn', url: contact.linkedin, icone: 'linkedin' },
  { label: 'Facebook', url: contact.facebook, icone: 'facebook' },
  { label: 'Instagram', url: contact.instagram, icone: 'instagram' },
];
const annee = new Date().getFullYear();
---

<section class="contact" id="contact">
  <div class={`showcase ${vitrine.type}`} aria-hidden="true">
    {
      vitrine.images.map((name, i) => (
        <Image class={`v v${i + 1}`} src={img(name)} alt="" widths={[360, 720]} sizes="(max-width: 860px) 60vw, 26vw" loading="lazy" />
      ))
    }
  </div>
  <div class="wrap inner">
    <h2>{titre}</h2>
    <p class="lead">{texte}</p>

    <div class="actions">
      <a class="btn btn-main" href={contact.whatsapp.url} target="_blank" rel="noopener">
        <Icon name="whatsapp" />WhatsApp {contact.whatsapp.numero}
      </a>
      <a class="btn btn-ghost" href={contact.telephone.url}><Icon name="phone" />{contact.telephone.numero}</a>
      <a class="btn btn-ghost" href={lien.url} target="_blank" rel="noopener"><Icon name={lien.icone} />{lien.label}</a>
    </div>

    <div class="more">
      <a class="mail" href={`mailto:${contact.email}`}><Icon name="mail" /><span>{contact.email}</span></a>
      <ul class="socials" aria-label="Réseaux sociaux">
        {
          reseaux.map((r) => (
            <li>
              <a href={r.url} target="_blank" rel="noopener">
                <Icon name={r.icone} />
                {r.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <a class="crossover" href={passerelle.url}>
      <strong>{passerelle.titre}</strong>
      <span>{passerelle.lien}</span>
    </a>

    <footer class="foot">
      <span>© {annee} Samson Klougan · Dream Conception</span>
      <span>Lomé, Togo</span>
    </footer>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 12vw, 9rem) clamp(2rem, 5vw, 3rem);
  }

  /* Vitrine de réalisations */
  .showcase {
    position: absolute;
    right: max(var(--gutter-r), 4vw);
    top: clamp(5rem, 12vw, 9rem);
    width: min(40vw, 560px);
    aspect-ratio: 7 / 6;
    pointer-events: none;
  }
  .showcase :global(.v) {
    position: absolute;
    height: auto;
    object-fit: cover;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
  }
  /* Affiches en éventail : la 1re au centre, devant */
  .affiches :global(.v) {
    border-radius: 12px;
  }
  .affiches :global(.v1) {
    width: 48%;
    left: 26%;
    top: 0;
    z-index: 2;
    transform: rotate(-1deg);
  }
  .affiches :global(.v2) {
    width: 44%;
    left: 2%;
    top: 12%;
    transform: rotate(-9deg);
  }
  .affiches :global(.v3) {
    width: 44%;
    right: 2%;
    top: 10%;
    transform: rotate(8deg);
  }
  /* Écrans de sites : le 1er en grand, les deux autres devant */
  .ecrans :global(.v) {
    border: 8px solid var(--indigo-3);
    border-radius: 14px;
    aspect-ratio: 16 / 10;
  }
  .ecrans :global(.v1) {
    width: 86%;
    left: 0;
    top: 0;
    border-width: 10px;
  }
  .ecrans :global(.v2) {
    width: 62%;
    right: 0;
    top: 46%;
    z-index: 2;
  }
  .ecrans :global(.v3) {
    width: 40%;
    left: 6%;
    top: 60%;
    z-index: 3;
  }
  .inner {
    display: grid;
    gap: 1.4rem;
  }
  h2 {
    font-size: clamp(2.8rem, 9vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 900;
    max-width: 9ch;
  }
  :global(.theme-dev) h2 {
    font-family: var(--mono);
    font-weight: 600;
    letter-spacing: -0.07em;
  }
  :global(.theme-design) h2 {
    font-stretch: 125%;
    max-width: 8ch;
  }
  .lead,
  .actions,
  .more {
    max-width: 58%;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.6rem;
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.6rem;
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 0.15rem;
    overflow-wrap: anywhere;
  }
  .socials {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--soft);
    transition: background-color 0.25s, color 0.25s;
  }
  .socials a:hover {
    background: var(--accent);
    color: var(--accent-fg);
  }
  .crossover {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.6rem 1.8rem;
    border-radius: 18px;
    text-decoration: none;
    background: var(--accent);
    color: var(--accent-fg);
    position: relative;
  }
  .crossover strong {
    font-size: clamp(1.3rem, 3vw, 2.2rem);
    font-stretch: 115%;
    letter-spacing: -0.02em;
  }
  .crossover span {
    font-weight: 600;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    opacity: 0.75;
    padding-top: 0.5rem;
  }

  @media (max-width: 860px) {
    .contact {
      padding-top: 4.5rem;
    }
    .showcase {
      position: relative;
      right: auto;
      top: auto;
      width: min(100% - var(--gutter-l) - var(--gutter-r), 420px);
      margin: 0 auto 2.5rem;
    }
    .lead,
    .actions,
    .more {
      max-width: none;
    }
  }
</style>
