---
// Vidéos : la première se lit sur place, les autres renvoient vers Facebook.
// Les fichiers vidéo vont dans public/videos (ils sont copiés tels quels).
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { img, optimized, background, lazyBackground } from '../../lib/images';
import videos from '../../data/videos.json';

const bg = await background('bg-reels.jpg', 1400, 800);
const items = await Promise.all(
  videos.map(async (v) => ({ ...v, posterUrl: v.poster ? await optimized(v.poster, 600, 75) : null })),
);
---

<section class="section band on-dark" id="video" {...lazyBackground(bg)}>
  <div class="wrap">
    <div class="sec-head">
      <h2 class="sec-title">En vidéo</h2>
      <p class="lead">Spots, reels et couverture d'événements, tournés et montés par mes soins.</p>
    </div>
    <div class="reels">
      {
        items.map((v) => (
          <figure>
            {v.video ? (
              <div class="phone">
                <video
                  src={`/videos/${v.video}`}
                  poster={v.posterUrl ?? undefined}
                  data-autoplay
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-label={v.alt ?? v.titre}
                />
              </div>
            ) : (
              <a class="phone link" href={v.lien} target="_blank" rel="noopener" aria-label={`Voir la vidéo sur Facebook : ${v.titre}`}>
                {v.image && <Image src={img(v.image)} alt={v.alt ?? v.titre} widths={[300, 600]} sizes="(max-width: 860px) 70vw, 300px" loading="lazy" />}
                <span class="play" aria-hidden="true">
                  <Icon name="play" />
                </span>
                <span class="watch">Voir sur Facebook</span>
              </a>
            )}
            <figcaption>
              <strong>{v.titre}</strong>
              <span>{v.texte}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  // La vidéo ne se télécharge et ne se lance que lorsqu'elle arrive à l'écran
  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((video) => {
    if (!('IntersectionObserver' in window)) return;
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0.4 },
    ).observe(video);
  });
</script>

<style>
  .band {
    background-image: linear-gradient(180deg, rgba(10, 13, 34, 0.72), rgba(10, 13, 34, 0.9)), var(--bg-lg);
    background-color: var(--nuit);
    background-size: cover;
    background-position: center;
  }
  .reels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 300px));
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  .phone {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: 28px;
    overflow: hidden;
    border: 6px solid var(--craie);
    background: var(--nuit);
    color: var(--craie);
    text-decoration: none;
  }
  .phone video,
  .phone :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .link:hover :global(img) {
    transform: scale(1.04);
  }
  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4rem;
    height: 4rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--safran);
    color: var(--indigo);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }
  .play :global(.icon) {
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
  }
  .watch {
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.8rem;
    padding: 0.5rem;
    border-radius: 999px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    background: rgba(10, 13, 34, 0.8);
  }
  figcaption {
    padding: 0.7rem 0.2rem 0;
    font-size: 0.9rem;
  }
  figcaption strong {
    display: block;
    font-size: 1rem;
  }
  @media (max-width: 860px) {
    .band {
      background-image: linear-gradient(180deg, rgba(10, 13, 34, 0.78), rgba(10, 13, 34, 0.92)), var(--bg-sm);
    }
    .reels {
      grid-template-columns: repeat(3, 68vw);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem;
    }
    figure {
      scroll-snap-align: start;
    }
  }
</style>
