---
// Pages réseaux sociaux gérées : résultats globaux puis une carte par page.
import Icon from '../Icon.astro';
import data from '../../data/pages-gerees.json';
---

<section class="section" id="pages">
  <div class="wrap">
    <h2 class="sec-title">Les pages que je fais grandir</h2>
    <p class="lead intro">{data.intro}</p>

    <div class="results">
      {
        data.resultats.map((r) => (
          <div>
            <strong>{r.valeur}</strong>
            <span>{r.texte}</span>
          </div>
        ))
      }
    </div>

    <div class="cards">
      {
        data.pages.map((p) => (
          <article class="card">
            <span class="net">{p.reseaux}</span>
            <h3>{p.nom}</h3>
            <div class="count">
              <strong>{p.abonnes}</strong>
              <span>abonnés</span>
            </div>
            <div class="links">
              {p.liens.map((l) => (
                <a href={l.url} target="_blank" rel="noopener">
                  {l.label}
                  <Icon name="arrow-up-right" />
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intro {
    margin-top: -1.5rem;
    margin-bottom: 2.5rem;
  }
  .results {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.6rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .results div {
    border-top: 2px solid var(--indigo);
    padding-top: 1rem;
  }
  .results strong {
    display: block;
    white-space: nowrap;
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    line-height: 0.95;
    font-weight: 900;
    font-stretch: 115%;
    letter-spacing: -0.035em;
  }
  .results span {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.92rem;
    font-weight: 500;
    max-width: 24ch;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.6rem);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: clamp(1.4rem, 2.5vw, 2rem);
    border-radius: 22px;
    background: var(--indigo);
    color: var(--craie);
  }
  .net {
    font-size: 0.85rem;
    color: var(--ciel);
  }
  h3 {
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    font-stretch: 110%;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .count {
    margin-top: auto;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(245, 244, 240, 0.2);
  }
  .count strong {
    display: block;
    white-space: nowrap;
    color: var(--safran);
    font-size: clamp(2rem, 3vw, 2.8rem);
    line-height: 1;
    font-stretch: 115%;
    letter-spacing: -0.03em;
  }
  .count span {
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    background: var(--safran);
    color: var(--indigo);
    transition: background-color 0.25s;
  }
  .links a:hover {
    background: var(--craie);
  }
  @media (max-width: 1100px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 860px) {
    .results {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
